---
import { links } from '../data/links';
const cols = [
  { h: 'Help pets', links: [['Adopt', links.adopt], ['Foster', links.foster], ['Volunteer', links.volunteer], ['Donate', links.donate], ['Pet Help', links.petHelp]] },
  { h: 'About', links: [['Our Story', links.ourStory], ['Programs', links.programs], ['Our Numbers', links.numbers], ['Leadership', links.leadership], ['Careers', links.careers]] },
  { h: 'More', links: [['Events', links.events], ['Thrift Stores', links.thrift], ['News & Blog', links.blog], ['Locations & Contact', links.contact], ['Volunteer Login', links.volunteerLogin]] },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="newsletter">
      <div>
        <h2>Get happy tails in your inbox 💌</h2>
        <p>One email a month: success stories, urgent needs, and events.</p>
      </div>
      <form action={links.newsletter} method="get" onsubmit={`location.href='${links.newsletter}';return false`} class="nl-form">
        <label for="nl-email" class="sr-only">Email address</label>
        <input id="nl-email" type="email" placeholder="you@example.com" required />
        <button class="btn btn-primary" type="submit">Sign up</button>
      </form>
    </div>

    <div class="grid">
      <div class="contact">
        <p class="brand"><img src="/apa-logo.svg" alt="Austin Pets Alive!" width="286" height="45" loading="lazy" /></p>
        <address>
          1156 West Cesar Chavez<br />Austin, TX 78703
        </address>
        <p>Shelter hours: 12–6 PM, every day<br /><a href="tel:+15129616519">512-961-6519</a></p>
        <ul class="social" aria-label="Social media">
          <li><a href="https://www.facebook.com/austinpetsalive/">Facebook</a></li>
          <li><a href="https://www.instagram.com/austinpetsalive/">Instagram</a></li>
          <li><a href="https://www.youtube.com/austinpetsalive">YouTube</a></li>
        </ul>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.h}>
          <h3>{c.h}</h3>
          <ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </nav>
      ))}
    </div>

    <div class="legal">
      <p>© {year} Austin Pets Alive! · 501(c)(3) nonprofit</p>
      <p><a href={links.privacy}>Privacy Policy</a> · <a href={links.donorPrivacy}>Donor Privacy Policy</a></p>
    </div>
    <p class="proto-note">Redesign prototype. Not the official Austin Pets Alive! website.</p>
  </div>
</footer>

<style>
  .footer { background: var(--maroon-deep); color: #f6e9e4; padding: 64px 0 32px; }
  .footer a { color: #f6e9e4; text-decoration: none; }
  .footer a:hover { color: var(--sun); text-decoration: underline; }
  .newsletter {
    display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap;
    background: var(--orange); color: #fff; border-radius: 28px; padding: clamp(24px, 4vw, 40px);
    box-shadow: 8px 8px 0 var(--sun);
  }
  .newsletter h2 { font-size: clamp(1.5rem, 3vw, 2rem); color: #fff; margin-bottom: .25em; }
  .newsletter p { margin: 0; color: #2e1110; font-weight: 700; }
  .nl-form { display: flex; gap: 8px; flex: 1; max-width: 460px; min-width: 260px; }
  .nl-form input { flex: 1; min-width: 0; padding: .85em 1.2em; border-radius: 999px; border: 2px solid var(--maroon-deep); background: #fff; color: var(--ink); font: inherit; }
  .nl-form .btn-primary { background: var(--maroon-deep); box-shadow: 0 5px 0 #2a0f0e; }
  .grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 32px; padding: 56px 0 40px; }
  .brand { margin-bottom: 1.2em; }
  .brand img { height: 32px; width: auto; max-width: 100%; filter: brightness(0) invert(1); }
  address { font-style: normal; margin-bottom: 1em; }
  .footer h3 { font-family: var(--font); font-size: .82rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--sun); margin-bottom: 1em; }
  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer li { margin-bottom: 0; }
  .footer li a { display: inline-block; padding: 6px 0; }
  .social { display: flex; gap: 16px; flex-wrap: wrap; }
  .contact a, .legal a { display: inline-block; padding: 12px 0; margin: -12px 0; }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: .9rem; opacity: .75; border-top: 1px solid rgba(255,255,255,.15); padding-top: 24px; }
  .legal p { margin: 0; }
  .proto-note { font-size: .8rem; opacity: .55; margin: 16px 0 0; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } .contact { grid-column: 1 / -1; } }
</style>
